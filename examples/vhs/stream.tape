# VHS tape for stream demo

Output examples/vhs/output/stream.gif

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 700
Set PlaybackSpeed 1.5
Set Theme "Catppuccin Mocha"

Hide
Type "cargo run --example stream"
Enter
Sleep 3s
Show

Sleep 5s

Type " "
Sleep 1s
Type " "
Sleep 2s

Type "t"
Sleep 1500ms
Type "t"
Sleep 1500ms
Type "T"
Sleep 1500ms

Type "q"
Sleep 1s
