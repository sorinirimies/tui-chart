# VHS tape for themes demo

Output examples/vhs/output/themes.gif

Set Shell "bash"
Set FontSize 14
Set Width 1200
Set Height 700
Set PlaybackSpeed 1.5
Set Theme "Catppuccin Mocha"

Hide
Type "cargo run --example themes"
Enter
Sleep 3s
Show

Sleep 2s

Type "t"
Sleep 1500ms
Type "t"
Sleep 1500ms
Type "t"
Sleep 1500ms
Type "t"
Sleep 1500ms
Type "t"
Sleep 1500ms
Type "T"
Sleep 1500ms

Type "q"
Sleep 1s
